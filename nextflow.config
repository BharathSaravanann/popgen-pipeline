params {
    vcf              = null
    vcf_index        = null
    outdir           = 'results'
    help             = false

    // For QC filters
    maf              = 0.05
    geno             = 0.05
    mind             = 0.10
    hwe              = 1e-4

    // For ROH
    homozyg_kb              = 200
    homozyg_snp             = 30
    homozyg_density         = 50
    homozyg_gap             = 1000
    homozyg_window_snp      = 30
    homozyg_window_het      = 1
    homozyg_window_missing  = 5
    froh_denom_mb           = 10

    // For LD pruning
    ld_window        = 50
    ld_step          = 5
    ld_r2            = 0.2

    // Kinship
    king_cutoff      = 0.0442
}

// container images (plink2 for other all stages, plink1.9 for ROH

def plink2_container   = 'ghcr.io/pgscatalog/plink2:2.00a5.10'
def plink19_container  = 'quay.io/biocontainers/plink:1.90b6.21--h779adbc_1'
def report_container   = 'popgen-report:1.0'

process {
    withName: QC_FILTER     { container = plink2_container }
    withName: ROH_ANALYSIS  { container = plink19_container }
    withName: LD_PRUNE      { container = plink2_container }
    withName: KINSHIP       { container = plink2_container }
    withName: REPORT        { container = report_container }

    cpus   = 2
    memory = '4 GB'
}

profiles {
    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        docker.fixOwnership  = true
    }

    standard {
        docker.enabled = false
    }
}

// run pipeline reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

manifest {
    name            = 'popgen-pipeline'
    description     = 'ROH and kinship/relatedness estimation from multi-sample VCF using PLINK, containerized with Docker.'
    author          = 'Bharath'
}
